# ---------------------------------------------------------------------------
# Career-Ops Platform configuration. Copy to platform/.env (setup does this).
# Never commit platform/.env — it is gitignored.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
NODE_ENV=development
# 0.0.0.0 = reachable from other devices on your network; 127.0.0.1 = this computer only.
HOST=0.0.0.0
PORT=4300
# The address people use to open the app. Used in password-reset and notification links.
# On a LAN use e.g. http://192.168.1.20:4300 ; in production use your https:// domain.
PUBLIC_URL=http://localhost:4300
# Set to true when running behind a reverse proxy (nginx, Caddy, a PaaS load balancer).
TRUST_PROXY=false
# Force the Secure flag on the session cookie (automatic when PUBLIC_URL is https://).
COOKIE_SECURE=false

# --- Storage --------------------------------------------------------------
# Default: <repo>/data/platform (already gitignored). Relative paths resolve from platform/.
# DATA_DIR=../data/platform
# DATABASE_PATH=../data/platform/career-ops.db
# UPLOAD_DIR=../data/platform/uploads
# MAIL_OUTBOX_DIR=../data/platform/outbox

# --- Accounts & security --------------------------------------------------
ALLOW_REGISTRATION=true
# true = new accounts stay "pending" until an admin approves them.
REQUIRE_ADMIN_APPROVAL=false
SESSION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=60
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15
MAX_UPLOAD_MB=5
MAX_RESUMES_PER_USER=10

# First administrator, created by "npm run setup" when no admin exists yet.
# Remove the password from this file after setup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Create two demo users during setup (development only).
SEED_DEMO_USERS=false

# --- Job fetching scheduler ----------------------------------------------
# worker   = separate process (npm run worker / start scripts start it)  [recommended]
# embedded = run the scheduler inside the web server process
# off      = no automatic fetching
SCHEDULER_MODE=worker
# Daily fetch time, server local time (HH:MM). Admins can change it in the UI.
FETCH_DAILY_AT=06:00
# Run a fetch at start-up when the last successful fetch is older than 24h.
FETCH_ON_STARTUP_IF_STALE=true
FETCH_CONCURRENCY=4
FETCH_SOURCE_TIMEOUT_MS=60000
# A posting that disappears from its source this many fetches in a row is marked expired.
EXPIRE_AFTER_MISSED_FETCHES=2
# Aggregator links verified per run (HTTP check of the apply link) and re-check interval.
LINK_CHECK_BUDGET=1500
LINK_RECHECK_DAYS=3
# Postings older than this many days are not imported / are expired.
MAX_JOB_AGE_DAYS=60
# Per-request HTTP timeout used by the career-ops providers (ms).
# CAREER_OPS_HTTP_TIMEOUT_MS=15000

# --- Email (optional) -----------------------------------------------------
# Without SMTP_HOST, emails (password resets, alerts) are written as .eml files
# to MAIL_OUTBOX_DIR instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Career-Ops <no-reply@example.com>

# --- Google Sheets (optional reporting layer) -----------------------------
# See platform/docs/GOOGLE_SHEETS.md. Share the spreadsheet with the service
# account email as an Editor.
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
# Either a path to the service-account JSON key file...
GOOGLE_APPLICATION_CREDENTIALS=
# ...or the two fields directly (private key with \n escapes on one line).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_TAB_PREFIX=Jobs
GOOGLE_SHEETS_MAX_DESCRIPTION_CHARS=2000
